<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Menu demo</title>
    <link rel="stylesheet" href="~/_content/Heroicsoft.NetForge.Components/css/nf.css" />
    <style>
        .demo-shell { display: flex; min-height: 100vh; }
        .demo-side { width: 16rem; flex: 0 0 auto; }
        .demo-main { flex: 1 1 auto; padding: 1.5rem 2rem; }
    </style>
</head>
<body>
    <div class="demo-shell">
        <aside class="demo-side">
            @Html.NetForgeMenu("Admin")
        </aside>
        <main class="demo-main">
            @RenderBody()
        </main>
    </div>
</body>
</html>
