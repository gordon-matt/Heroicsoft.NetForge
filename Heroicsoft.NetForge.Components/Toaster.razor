@implements IDisposable
@inject ToastService ToastService
@inject IJSRuntime JS
@inject IOptions<Heroicsoft.NetForge.Components.ForgeToastSoundOptions> SoundOptions

<div class="nf-toasts" role="region" aria-label="Notifications" aria-live="polite">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="nf-toast nf-toast-@toast.Level" role="@(toast.Level == "danger" ? "alert" : "status")" @key="toast.Id">
            <Icon Name="@IconFor(toast.Level)" Class="nf-toast-icon" />
            <span class="nf-toast-message">@toast.Message</span>
            <button type="button" class="nf-icon-button nf-toast-close" aria-label="Dismiss"
                    @onclick="() => ToastService.Dismiss(toast.Id)">
                <Icon Name="x" Size="16" />
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.Changed += OnToastsChanged;
        ToastService.Shown += OnToastShown;
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private void OnToastShown(ToastService.Toast toast)
    {
        string? sound = SoundOptions.Value.SoundFor(toast.Level);
        if (sound is null)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await JS.InvokeVoidAsync("netForge.playSound", sound);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
            {
                // Prerendering, a dropped circuit, or a page without the NetForge script: stay silent.
            }
        });
    }
    private static string IconFor(string level) => level switch
    {
        "success" => "check-circle",
        "danger" => "danger",
        "warning" => "warning",
        _ => "info",
    };

    public void Dispose()
    {
        ToastService.Changed -= OnToastsChanged;
        ToastService.Shown -= OnToastShown;
    }
}
