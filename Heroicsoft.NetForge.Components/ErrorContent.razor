@namespace Heroicsoft.NetForge.Components
@using System.Diagnostics

<div class="container py-5">
    <div class="text-center">
        <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
        <h1 class="h3 mt-3">@Title</h1>
        <p class="text-body-secondary">@Message</p>

        @if (requestId is not null)
        {
            <p class="small text-body-tertiary">
                Reference: <code>@requestId</code>
            </p>
        }

        <a class="btn btn-primary" href="@HomeHref">
            <i class="bi bi-house-door me-1"></i> @HomeLabel
        </a>
    </div>
</div>

@code {
    private string? requestId;

    [Parameter]
    public string Title { get; set; } = "Something went wrong";

    [Parameter]
    public string Message { get; set; } = "The error has been logged. Trying again often works.";

    [Parameter]
    public string HomeHref { get; set; } = "/";

    [Parameter]
    public string HomeLabel { get; set; } = "Back home";

    /// <summary>
    /// The correlation id an administrator can search the log for. Taken from the ambient activity
    /// rather than <c>HttpContext</c>, which is null once the page is rendering interactively.
    /// </summary>
    protected override void OnInitialized() => requestId = Activity.Current?.Id;
}
