@namespace Heroicsoft.NetForge.Components

@* Shown in place of a page's content when the signed-in user lacks the role. A redirect back
   to sign-in for someone already signed in reads as a bug. *@
<EmptyState Icon="@Icon" Title="@Title" Description="@Description">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <a class="btn btn-sm btn-outline-secondary" href="@HomeHref">@HomeLabel</a>
    }
</EmptyState>

@code {
    [Parameter]
    public string Icon { get; set; } = "bi-shield-lock";

    [Parameter]
    public string Title { get; set; } = "You don't have access to this";

    [Parameter]
    public string Description { get; set; } = "Ask an administrator if you think you should.";

    [Parameter]
    public string HomeHref { get; set; } = "/";

    [Parameter]
    public string HomeLabel { get; set; } = "Back home";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
