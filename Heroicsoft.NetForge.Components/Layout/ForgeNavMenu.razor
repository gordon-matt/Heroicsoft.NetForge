@if (string.IsNullOrWhiteSpace(Section.Heading))
{
    @foreach (var item in Section.Items)
    {
        @if (string.IsNullOrEmpty(item.Roles))
        {
            <ForgeNavLink Item="item" />
        }
        else
        {
            <AuthorizeView Roles="@item.Roles">
                <ForgeNavLink Item="item" />
            </AuthorizeView>
        }
    }
}
else
{
    <li class="nf-nav-item">
        <div class="nf-menu" @onkeydown="OnKeyDown">
            <button type="button" class="nf-nav-link nf-menu-toggle @(AnyCurrent ? "active" : null)"
                    aria-haspopup="menu" aria-expanded="@open" @onclick="Toggle">
                <span class="nf-nav-label">@Section.Heading</span>
                <Icon Name="chevron-down" Size="14" />
            </button>
            @if (open)
            {
                <div class="nf-menu-scrim" @onclick="Close"></div>
                <div class="nf-menu-list is-start" role="menu">
                    @foreach (var item in Section.Items)
                    {
                        @if (string.IsNullOrEmpty(item.Roles))
                        {
                            @MenuItem(item)
                        }
                        else
                        {
                            <AuthorizeView Roles="@item.Roles">
                                @MenuItem(item)
                            </AuthorizeView>
                        }
                    }
                </div>
            }
        </div>
    </li>
}

@code {
    private RenderFragment MenuItem(ForgeNavItem item) => @<text>
        @if (item.Children is { Count: > 0 } && string.IsNullOrWhiteSpace(item.Href))
        {
            <button type="button" class="nf-menu-item" @onclick="() => ToggleChild(item.Title)" @onclick:stopPropagation="true">
                <Icon Name="@item.Icon" />
                <span>@item.Title</span>
                <Icon Name="@(openChild == item.Title ? "chevron-down" : "chevron-right")" Size="14" />
            </button>
            @if (openChild == item.Title)
            {
                <div class="nf-menu-list" role="menu">
                    @foreach (var child in item.Children)
                    {
                        @Leaf(child)
                    }
                </div>
            }
        }
        else
        {
            @Leaf(item)
        }
    </text>;

    private RenderFragment Leaf(ForgeNavItem item) => @<a class="nf-menu-item @(ForgeNavMatch.IsCurrent(item, RelativeUrl) ? "is-active" : null)"
        role="menuitem" href="@item.Href" target="@(item.External ? "_blank" : null)"
        rel="@(item.External ? "noopener" : null)" @onclick="Close">
        <Icon Name="@item.Icon" />
        <span>@item.Title</span>
        @if (item.External)
        {
            <Icon Name="external" Size="14" Class="nf-nav-external" />
        }
    </a>;
}