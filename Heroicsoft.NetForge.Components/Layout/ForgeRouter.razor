<Router AppAssembly="AppAssembly"
        AdditionalAssemblies="@(AdditionalAssemblies ?? Array.Empty<Assembly>())"
        NotFoundPage="NotFoundPage">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="DefaultLayout">
            <NotAuthorized>
                @if (NotAuthorized is not null)
                {
                    @NotAuthorized
                }
                else if (context.User.Identity?.IsAuthenticated == true)
                {
                    @* Signed in but missing a role: another sign-in would loop. *@
                    <AccessDenied />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <AuthorizingMessage Message="@AuthorizingText" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="@FocusSelector" />
    </Found>
</Router>
