@if (Open || Persistent)
{
    @if (Scrim && Open && !Inline)
    {
        <div class="nf-drawer-scrim" @onclick="CloseAsync"></div>
    }
    <aside class="@PanelClass" style="@PanelStyle" aria-label="@Label" aria-hidden="@(!Open)" @onkeydown="OnKeyDownAsync">
        <header class="nf-drawer-head">
            <div class="nf-drawer-title">
                @if (TitleContent is not null)
                {
                    @TitleContent
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <strong>@Title</strong>
                }
            </div>
            <div class="nf-drawer-actions">
                @Actions
                <button type="button" class="nf-icon-button" title="Close" @onclick="CloseAsync">
                    <Icon Name="x" />
                </button>
            </div>
        </header>
        <div class="nf-drawer-body @BodyClass">
            @ChildContent
        </div>
    </aside>
}
