@implements IConfirmDialog
@implements IDisposable

@* Modal driven from C#, so callers can await a decision instead of wiring callbacks. Escape and
   a click on the backdrop both count as Cancel. *@
@if (isVisible)
{
    <div class="nf-modal-backdrop" @onclick="() => Close(false)" @onkeydown="OnKeyDown">
        <div class="nf-modal" role="dialog" aria-modal="true" aria-labelledby="@titleId"
             aria-describedby="@messageId" @onclick:stopPropagation="true">
            <h2 class="nf-modal-title" id="@titleId">@title</h2>
            <p class="nf-modal-message" id="@messageId">@message</p>
            @if (detail is not null)
            {
                <p class="nf-modal-detail">@detail</p>
            }
            <div class="nf-modal-actions">
                <button type="button" class="nf-button" @ref="cancelButton" @onclick="() => Close(false)">
                    Cancel
                </button>
                <button type="button" class="nf-button @(isDestructive ? "nf-button-danger-solid" : "nf-button-primary")"
                        @ref="confirmButton" @onclick="() => Close(true)">
                    @confirmLabel
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string titleId = "nf-confirm-title-" + Guid.NewGuid().ToString("N");
    private readonly string messageId = "nf-confirm-message-" + Guid.NewGuid().ToString("N");
    private bool isVisible;
    private bool isDestructive;
    private bool shouldFocus;
    private string title = string.Empty;
    private string message = string.Empty;
    private string? detail;
    private string confirmLabel = "OK";
    private ElementReference cancelButton;
    private ElementReference confirmButton;
    private TaskCompletionSource<bool>? completion;

    /// <summary>
    /// Shows the dialog and completes when the user answers. Awaiting the answer keeps the
    /// caller's logic in one place rather than split across an event handler.
    /// </summary>
    public Task<bool> ShowAsync(
        string title,
        string message,
        string confirmLabel = "OK",
        bool isDestructive = false,
        string? detail = null)
    {
        // A second dialog replaces the first; the first caller gets "no" rather than waiting forever.
        completion?.TrySetResult(false);

        this.title = title;
        this.message = message;
        this.detail = detail;
        this.confirmLabel = confirmLabel;
        this.isDestructive = isDestructive;

        isVisible = true;
        shouldFocus = true;
        completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);

        StateHasChanged();

        return completion.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldFocus)
        {
            return;
        }

        shouldFocus = false;

        try
        {
            // The safe answer is focused for destructive actions, so Enter can't delete by accident.
            await (isDestructive ? cancelButton : confirmButton).FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Focus is a nicety. The circuit may be gone, or the dialog closed before this ran.
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Close(false);
        }
    }

    private void Close(bool confirmed)
    {
        isVisible = false;
        completion?.TrySetResult(confirmed);
        completion = null;
    }

    public void Dispose() => completion?.TrySetResult(false);
}
