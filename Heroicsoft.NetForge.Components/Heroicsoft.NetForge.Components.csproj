<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Heroicsoft.NetForge.Components</RootNamespace>
		<Description>Blazor shell, dialogs, toasts, and status pages in the unified NetForge (nf-) style, plus the toast, dialog, and sidebar services that Heroicsoft.NetForge.Components.Bootstrap shares. Includes the shared menu (Blazor component and MVC helper) that a host builds and Razor Class Libraries contribute to.</Description>
		<PackageTags>netforge;blazor;razor;components;ui;dialogs;toasts;navigation;theming;dark-mode</PackageTags>
		<Version>1.2.7.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<Import Project="..\Heroicsoft.NetForge.WebAssets\build\Heroicsoft.NetForge.WebAssets.targets" />

	<ItemGroup>
		<ProjectReference Include="..\Heroicsoft.NetForge.Abstractions\Heroicsoft.NetForge.Abstractions.csproj" />
		<ProjectReference Include="..\Heroicsoft.NetForge.Results\Heroicsoft.NetForge.Results.csproj" />
		<ProjectReference Include="..\Heroicsoft.NetForge.WebAssets\Heroicsoft.NetForge.WebAssets.csproj" />
	</ItemGroup>

</Project>
