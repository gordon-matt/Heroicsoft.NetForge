@inherits LayoutComponentBase

@* For pages that own the whole viewport: setup, errors, anything reached before the shell
   has the data it needs to render a sidebar. *@
<div class="nf-standalone">
    <div class="nf-standalone-body">
        @Body
    </div>
</div>

<ForgeDialogHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&times;</span>
</div>
