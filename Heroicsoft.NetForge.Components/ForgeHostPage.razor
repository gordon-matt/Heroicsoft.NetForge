@inject IOptions<ForgeUiOptions> UiOptions

<!DOCTYPE html>
<html lang="en" data-theme="@InitialTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@Title</title>
    <ResourcePreloader />
    @* Before the stylesheets, so the stored scheme is on <html> before anything paints. *@
    <script src="@Assets[$"{AssetBase}/js/theme-init.js"]"
            data-theme-key="@Ui.ThemeStorageKey"
            data-default-theme="@DefaultScheme"></script>
    <link rel="stylesheet" href="@Assets[$"{AssetBase}/css/nf.css"]" />
    @if (AccentCss is not null)
    {
        @* After nf.css, so it overrides the default indigo. *@
        <style>@((MarkupString)AccentCss)</style>
    }
    @if (!string.IsNullOrWhiteSpace(AppStylesheet))
    {
        <link rel="stylesheet" href="@AppStylesheet" />
    }
    @if (!string.IsNullOrWhiteSpace(IconHref))
    {
        <link rel="icon" type="image/png" href="@IconHref" />
    }
    @AdditionalHead
    <ImportMap />
    <HeadOutlet @rendermode="@RenderModeInUse" />
</head>

<body>
    @ChildContent
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets[$"{AssetBase}/js/nf.js"]"></script>
    @AdditionalBody
</body>

</html>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? IconHref { get; set; }

    /// <summary>App stylesheet href, usually <c>@@Assets["css/site.css"]</c> from the host.</summary>
    [Parameter]
    public string? AppStylesheet { get; set; }

    [Parameter]
    public IComponentRenderMode? PageRenderMode { get; set; }

    [Parameter]
    public RenderFragment? AdditionalHead { get; set; }

    [Parameter]
    public RenderFragment? AdditionalBody { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Where the static web assets of this package are served. The path has to be spelled out:
    /// inside a class library <c>@@Assets["js/nf.js"]</c> resolves against the host, not here.
    /// </summary>
    private const string AssetBase = "_content/Heroicsoft.NetForge.Components";

    private ForgeUiOptions Ui => UiOptions.Value;

    private string? AccentCss => ForgeAccentCss.Build(Ui);

    /// <summary>The scheme server-rendered markup starts in; theme-init.js refines it before paint.</summary>
    private string InitialTheme =>
        string.Equals(Ui.DefaultColorScheme, "dark", StringComparison.OrdinalIgnoreCase) ? "dark" : "light";

    private string DefaultScheme =>
        Ui.DefaultColorScheme?.Trim().ToLowerInvariant() switch
        {
            "dark" => "dark",
            "system" => "system",
            _ => "light",
        };

    private IComponentRenderMode RenderModeInUse =>
        PageRenderMode ?? Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer;
}
