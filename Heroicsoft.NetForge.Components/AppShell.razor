@implements IDisposable
@inject NavigationManager Navigation

<div class="nf-shell @(sidebarCollapsed ? "nf-sidebar-collapsed" : null) @(sidebarOpen ? "nf-sidebar-open" : null) @(NavigationPlacement == ForgeNavigationPlacement.Topbar ? "nf-shell-topnav" : null)">
    @if (NavigationPlacement != ForgeNavigationPlacement.Topbar)
    {
        @if (Sidebar is not null)
        {
            @Sidebar
        }
        else
        {
            <ForgeSidebar Sections="Sections" Brand="@Brand" BrandHref="@BrandHref"
                          LogoUrl="@LogoUrl" LogoDarkUrl="@LogoDarkUrl" MarkUrl="@MarkUrl"
                          BrandContent="BrandContent" SidebarFooter="SidebarFooter" />
        }
    }

    @* Only visible while the off-canvas sidebar is open on a narrow screen. *@
    <div class="nf-scrim" @onclick="CloseSidebar"></div>

    <div class="nf-main">
        <ForgeTopbar ShowSearch="ShowSearch" SearchPlaceholder="@SearchPlaceholder" SearchText="@SearchText"
                     OnSearch="OnSearch" OnToggleSidebar="ToggleSidebar" ShowThemePicker="ShowThemePicker"
                     ShowSidebarToggle="@(NavigationPlacement != ForgeNavigationPlacement.Topbar)"
                     Sections="@(NavigationPlacement == ForgeNavigationPlacement.Topbar ? Sections : [])"
                     Brand="@Brand" BrandHref="@BrandHref" LogoUrl="@LogoUrl" LogoDarkUrl="@LogoDarkUrl"
                     ShowUserMenu="ShowUserMenu" UserMenuItems="UserMenuItems">
            @TopbarEnd
        </ForgeTopbar>

        <main class="nf-content">
            @ChildContent
        </main>

        @if (ShowVersion)
        {
            <footer class="nf-version">v@(Version ?? AppVersion.Current)</footer>
        }
    </div>
</div>

<ForgeDialogHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    // Two flags because the toggle means different things by width: on a wide screen it
    // collapses the sidebar to an icon rail, on a narrow one it slides the sidebar over the page.
    // CSS applies whichever flag matches the breakpoint.
    private bool sidebarCollapsed;
    private bool sidebarOpen;

    [Parameter]
    public string? Brand { get; set; }

    [Parameter]
    public string BrandHref { get; set; } = "/";

    [Parameter]
    public string? LogoUrl { get; set; }

    [Parameter]
    public string? LogoDarkUrl { get; set; }

    [Parameter]
    public string? MarkUrl { get; set; }

    [Parameter]
    public RenderFragment? BrandContent { get; set; }

    [Parameter]
    public IReadOnlyList<ForgeNavSection> Sections { get; set; } = [];

    /// <summary>Sidebar is the default. Topbar draws <see cref="Sections"/> in the header instead.</summary>
    [Parameter]
    public ForgeNavigationPlacement NavigationPlacement { get; set; } = ForgeNavigationPlacement.Sidebar;

    /// <summary>Replaces the generated sidebar. Use this when the nav is data the page owns.</summary>
    [Parameter]
    public RenderFragment? Sidebar { get; set; }

    /// <summary>Pinned at the bottom of the generated sidebar, for example a user name and sign-out button.</summary>
    [Parameter]
    public RenderFragment? SidebarFooter { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    /// <summary>The term currently in the address bar. The box copies this when the page changes.</summary>
    [Parameter]
    public string SearchText { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public RenderFragment? TopbarEnd { get; set; }

    /// <summary>Shows the light or dark toggle in the topbar. The name matches the Bootstrap shell.</summary>
    [Parameter]
    public bool ShowThemePicker { get; set; } = true;

    [Parameter]
    public bool ShowUserMenu { get; set; } = true;

    [Parameter]
    public IReadOnlyList<ForgeNavItem>? UserMenuItems { get; set; }

    [Parameter]
    public bool ShowVersion { get; set; } = true;

    [Parameter]
    public string? Version { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar() => sidebarOpen = false;

    // A link tapped in the off-canvas sidebar should reveal the page it opened.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!sidebarOpen)
        {
            return;
        }

        sidebarOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
