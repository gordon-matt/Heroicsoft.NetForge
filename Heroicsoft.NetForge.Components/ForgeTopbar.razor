@inject IAuthProviderService Auth

<header class="nf-topbar">
    @if (ShowSidebarToggle)
    {
        <button type="button" class="nf-icon-button nf-sidebar-toggle" title="Toggle sidebar"
                aria-label="Toggle sidebar" aria-controls="nf-sidebar" @onclick="OnToggleSidebar">
            <Icon Name="menu" />
        </button>
    }
    else if (LogoUrl is not null || !string.IsNullOrWhiteSpace(Brand))
    {
        <a class="nf-brand-link nf-topbar-brand" href="@BrandHref">
            @if (LogoUrl is not null)
            {
                <img class="nf-brand-logo @(LogoDarkUrl is not null ? "nf-has-dark" : null)" src="@LogoUrl" alt="@Brand" />
                @if (LogoDarkUrl is not null)
                {
                    <img class="nf-brand-logo-dark" src="@LogoDarkUrl" alt="@Brand" />
                }
            }
            else
            {
                <span class="nf-brand-text">@Brand</span>
            }
        </a>
    }

    @if (Sections.Count > 0)
    {
        <button type="button" class="nf-icon-button nf-topnav-toggle" title="Menu" aria-expanded="@navOpen"
                @onclick="() => navOpen = !navOpen">
            <Icon Name="menu" />
        </button>
        <ul class="nf-topnav @(navOpen ? "is-open" : null)">
            @foreach (var section in Sections)
            {
                @if (string.IsNullOrEmpty(section.Roles))
                {
                    <ForgeNavMenu Section="section" />
                }
                else
                {
                    <AuthorizeView Roles="@section.Roles">
                        <ForgeNavMenu Section="section" />
                    </AuthorizeView>
                }
            }
        </ul>
    }

    @if (ShowSearch)
    {
        <form class="nf-search" role="search" @onsubmit="SubmitSearch" @onsubmit:preventDefault="true">
            <Icon Name="search" />
            <input type="search" data-nf-search placeholder="@SearchPlaceholder" aria-label="@SearchPlaceholder"
                   autocomplete="off" value="@searchTerm" @oninput="OnInput" />
            <kbd aria-hidden="true">/</kbd>
        </form>
    }

    <div class="nf-topbar-end">
        @if (ShowThemePicker)
        {
            <ThemeToggle />
        }

        @ChildContent

        @if (ShowUserMenu)
        {
            <AuthorizeView>
                <Authorized>
                    <div class="nf-menu" @onkeydown="OnMenuKeyDown">
                        <button type="button" class="nf-menu-toggle" aria-haspopup="menu"
                                aria-expanded="@(menuOpen ? "true" : "false")" @onclick="ToggleMenu">
                            <Icon Name="user" Size="20" />
                            <span class="nf-menu-name">@context.User.Identity?.Name</span>
                            <Icon Name="chevron-down" Size="14" />
                        </button>

                        @if (menuOpen)
                        {
                            <div class="nf-menu-scrim" @onclick="CloseMenu"></div>
                            <div class="nf-menu-list" role="menu">
                                @foreach (var item in VisibleUserMenuItems(context.User))
                                {
                                    <a class="nf-menu-item" role="menuitem" href="@item.Href" @onclick="CloseMenu"><Icon Name="@item.Icon" /> @item.Title</a>
                                }
                                @if (Auth.Provider != AuthProvider.None)
                                {
                                    @* A POST, so a stray link prefetch can't sign the user out. *@
                                    <form action="@LogoutUrl" method="post">
                                        <AntiforgeryToken />
                                        <button type="submit" class="nf-menu-item" role="menuitem">
                                            <Icon Name="logout" /> Sign out
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="nf-menu-note">Running without authentication</span>
                                }
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="nf-button nf-button-primary" href="@LoginHref">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        }
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    [Parameter]
    public bool ShowSidebarToggle { get; set; } = true;

    [Parameter]
    public IReadOnlyList<ForgeNavSection> Sections { get; set; } = [];

    [Parameter]
    public string? Brand { get; set; }

    [Parameter]
    public string BrandHref { get; set; } = "/";

    [Parameter]
    public string? LogoUrl { get; set; }

    [Parameter]
    public string? LogoDarkUrl { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter]
    public string SearchText { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    /// <summary>Shows the light or dark toggle. The name matches the Bootstrap topbar.</summary>
    [Parameter]
    public bool ShowThemePicker { get; set; } = true;

    [Parameter]
    public bool ShowUserMenu { get; set; } = true;

    [Parameter]
    public IReadOnlyList<ForgeNavItem>? UserMenuItems { get; set; }

    private List<ForgeNavItem> VisibleUserMenuItems(System.Security.Claims.ClaimsPrincipal user) =>
        (UserMenuItems ?? [])
            .Where(item => string.IsNullOrWhiteSpace(item.Roles)
                || item.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Any(user.IsInRole))
            .ToList();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string searchTerm = string.Empty;
    private string appliedSearchText = string.Empty;
    private bool menuOpen;
    private bool navOpen;

    protected override void OnParametersSet()
    {
        if (!string.Equals(SearchText, appliedSearchText, StringComparison.Ordinal))
        {
            appliedSearchText = SearchText ?? string.Empty;
            searchTerm = appliedSearchText;
        }
    }

    private string LogoutUrl => Auth.Provider == AuthProvider.Keycloak
        ? "/auth/logout"
        : "/Identity/Account/Logout";

    private string LoginHref => Auth.Provider switch
    {
        AuthProvider.Keycloak => "/auth/login",
        AuthProvider.Identity => "/Identity/Account/Login",
        _ => "/",
    };

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private void OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            menuOpen = false;
        }
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;

        // The search box's clear button empties the field without submitting the form.
        if (searchTerm.Length == 0)
        {
            await SubmitSearch();
        }
    }

    private Task SubmitSearch() => OnSearch.InvokeAsync(searchTerm.Trim());
}
