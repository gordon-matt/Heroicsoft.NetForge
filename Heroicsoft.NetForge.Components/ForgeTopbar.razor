@namespace Heroicsoft.NetForge.Components
@inject IAuthProviderService Auth

<header class="bf-topbar">
    <button type="button" class="btn btn-sm btn-link bf-sidebar-toggle" title="Toggle sidebar"
            @onclick="OnToggleSidebar">
        <i class="bi bi-list fs-4"></i>
    </button>

    @if (ShowSearch)
    {
        <form class="bf-topbar-search" @onsubmit="SubmitSearch" @onsubmit:preventDefault="true">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-body-tertiary border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="search" class="form-control border-start-0"
                       placeholder="@SearchPlaceholder"
                       aria-label="@SearchPlaceholder" @bind="searchTerm" @bind:event="oninput" />
            </div>
        </form>
    }

    <div class="ms-auto d-flex align-items-center gap-1">
        @if (ShowThemePicker)
        {
            <ThemePickerOpener />
        }

        @ChildContent

        @if (ShowUserMenu)
        {
            <AuthorizeView>
                <Authorized>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link dropdown-toggle text-body" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-md-inline ms-1">@context.User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (Auth.Provider != AuthProvider.None)
                            {
                                <li>
                                    @* A POST, so a stray link prefetch can't sign the user out. *@
                                    <form action="@LogoutUrl" method="post">
                                        <AntiforgeryToken />
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign out
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <span class="dropdown-item-text small text-body-secondary">
                                        Running without authentication
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-sm btn-primary" href="@LoginHref">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        }
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public bool ShowThemePicker { get; set; } = true;

    [Parameter]
    public bool ShowUserMenu { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string searchTerm = string.Empty;

    private string LogoutUrl => Auth.Provider == AuthProvider.Keycloak
        ? "/auth/logout"
        : "/Identity/Account/Logout";

    private string LoginHref => Auth.Provider switch
    {
        AuthProvider.Keycloak => "/auth/login",
        AuthProvider.Identity => "/Identity/Account/Login",
        _ => "/",
    };

    private async Task SubmitSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return;
        }

        await OnSearch.InvokeAsync(searchTerm.Trim());
    }
}
