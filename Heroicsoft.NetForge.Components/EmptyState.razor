<div class="nf-empty">
    <Icon Name="@Icon" Size="40" Class="nf-empty-icon" />
    <h2 class="nf-empty-title">@Title</h2>
    @if (Description is not null)
    {
        <p class="nf-empty-description">@Description</p>
    }
    @if (ChildContent is not null)
    {
        <div class="nf-empty-body">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Icon name from <see cref="IconSet"/>, for example <c>inbox</c>. Bootstrap Icons names are mapped.</summary>
    [Parameter]
    public string Icon { get; set; } = "inbox";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
