<div class="nf-page-header">
    <div class="nf-page-header-text">
        <h1 class="nf-page-title">
            @if (Icon is not null)
            {
                <Icon Name="@Icon" Size="22" Class="nf-page-title-icon" />
            }
            @Title
        </h1>
        @if (Description is not null)
        {
            <p class="nf-page-description">@Description</p>
        }
        @ChildContent
    </div>

    @if (Actions is not null)
    {
        <div class="nf-page-actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Icon name from <see cref="IconSet"/>. Bootstrap Icons names are mapped.</summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
