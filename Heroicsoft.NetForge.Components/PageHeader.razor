@namespace Heroicsoft.NetForge.Components

<div class="bf-page-header">
    <div class="min-width-0">
        <h1 class="h3 mb-1">
            @if (Icon is not null)
            {
                <i class="bi @IconClass me-2 text-primary"></i>
            }
            @Title
        </h1>
        @if (Description is not null)
        {
            <p class="text-body-secondary mb-0">@Description</p>
        }
        @ChildContent
    </div>

    @if (Actions is not null)
    {
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string IconClass => Icon is null
        ? string.Empty
        : Icon.StartsWith("bi-", StringComparison.Ordinal) || Icon.StartsWith("bi ", StringComparison.Ordinal)
            ? Icon
            : $"bi-{Icon}";
}
