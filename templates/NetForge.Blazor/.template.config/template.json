{
  "$schema": "http://json.schemastore.org/template",
  "author": "Heroicsoft",
  "classifications": [ "Blazor", "Web", "NetForge" ],
  "identity": "Heroicsoft.NetForge.Templates.Blazor",
  "name": "NetForge Blazor App",
  "description": "Blazor Server app on the NetForge shell, with Core, Data, one project per database provider, Services, and Tests already wired.",
  "shortName": "netforge-blazor",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "NetForgeApp",
  "preferNameDirectory": true,
  "symbols": {
    "appKey": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "netforgeapp",
      "fileRename": "netforgeapp"
    }
  },
  "icon": "icon.png",
  "sources": {
    "modifiers": [
      {
        "exclude": [ "**/bin/**", "**/obj/**", "**/.vs/**", "**/*.user", "**/*_design.db" ]
      }
    ]
  }
}
