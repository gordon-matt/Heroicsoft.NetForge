{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "LogVue": {
    "Title": "NetForgeApp",
    "RetentionDays": 30
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=netforgeapp.db"
  },
  "Authentication": {
    "Provider": "Identity",
    "Keycloak": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "AdminClientId": "",
      "AdminClientSecret": "",
      "PublicOrigin": "",
      "BackchannelBaseUrl": ""
    }
  },
  "Seed": {
    "Admin": {
      "Email": "admin@netforgeapp.local",
      "UserName": "admin",
      "Password": "Admin@123"
    }
  }
}
