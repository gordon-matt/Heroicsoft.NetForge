<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Heroicsoft.NetForge.Video</RootNamespace>
		<Description>FFmpeg bootstrap, frame capture, transcode, integrity check, and PCM-to-AAC encode for Heroicsoft apps. Wraps Xabe.FFmpeg so Kinnect, MyVideoArchive, and Shelfwarden share one tools path and one set of arguments.</Description>
		<PackageTags>netforge;video;ffmpeg;xabe-ffmpeg;transcode;thumbnail;aac</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Xabe.FFmpeg" />
		<PackageReference Include="Xabe.FFmpeg.Downloader" />
	</ItemGroup>

</Project>
