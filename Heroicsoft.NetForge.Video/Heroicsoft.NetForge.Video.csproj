<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Heroicsoft.NetForge.Video</RootNamespace>
		<Description>FFmpeg bootstrap, frame capture, transcode, integrity check, and PCM-to-AAC encode for Heroicsoft apps. Wraps Xabe.FFmpeg so Kinnect, MyVideoArchive, and Shelfwarden share one tools path and one set of arguments.</Description>
		<Version>1.2.0-beta</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="Xabe.FFmpeg" Version="6.1.1" />
		<PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.1.1" />
	</ItemGroup>

</Project>
