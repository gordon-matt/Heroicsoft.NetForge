<!DOCTYPE html>
<html lang="en" data-bs-theme="@InitialScheme" data-theme="@InitialScheme" data-nf-storage-key="@StorageKey" data-nf-theme-area="@ResolvedArea">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@Title</title>
    <ResourcePreloader />
    @* Not fingerprinted by the theme picker: theme-init.js and ThemePicker both swap this href. *@
    <link id="theme-stylesheet" rel="stylesheet" href="@BootswatchThemes.StylesheetHref(InitialTheme, Ui.StylesheetFormat)" />
    <script src="@Assets[$"{AssetBase}/js/theme-init.js"]"
            data-theme-key="@Ui.ThemeStorageKey"
            data-default-theme="@DefaultThemeName"
            data-theme-areas="@AreasAttribute"
            data-theme-area="@PinnedArea"
            data-stylesheet-format="@Ui.StylesheetFormat"></script>
    <link rel="stylesheet" href="@Ui.IconsStylesheetPath" />
    <link rel="stylesheet" href="@Assets[$"{AssetBase}/css/forge.css"]" />
    @if (!string.IsNullOrWhiteSpace(AppStylesheet))
    {
        <link rel="stylesheet" href="@AppStylesheet" />
    }
    @if (!string.IsNullOrWhiteSpace(IconHref))
    {
        <link rel="icon" type="image/png" href="@IconHref" />
    }
    @AdditionalHead
    <ImportMap />
    <HeadOutlet @rendermode="@RenderModeInUse" />
</head>

<body>
    @ChildContent
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Ui.BootstrapScriptPath"></script>
    <script src="@Assets[$"{AssetBase}/js/forge.js"]"></script>
    @AdditionalBody
</body>

</html>
