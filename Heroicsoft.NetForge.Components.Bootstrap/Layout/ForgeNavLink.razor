<li class="nav-item">
    @if (Item.External)
    {
        <a class="nav-link" href="@Item.Href" target="_blank" rel="noopener" title="@Tip">
            @if (Item.TagIcon)
            {
                <i class="bi bi-circle-fill bf-tag-icon" aria-hidden="true"></i>
            }
            else
            {
                <i class="bi @IconClass"></i>
            }
            <span class="bf-truncate">@Item.Title</span>
            <i class="bi bi-box-arrow-up-right ms-auto small"></i>
        </a>
    }
    else if (UsesQuery)
    {
        <a class="nav-link @(IsCurrent ? "active" : null)" href="@Item.Href" title="@Tip">
            @if (Item.TagIcon)
            {
                <i class="bi bi-circle-fill bf-tag-icon" aria-hidden="true"></i>
            }
            else
            {
                <i class="bi @IconClass"></i>
            }
            <span class="bf-truncate">@Item.Title</span>
            @if (Item.Count is int queryCount)
            {
                <span class="ms-auto small text-body-secondary">@queryCount.ToString("N0")</span>
            }
            else if (!string.IsNullOrEmpty(Item.Badge))
            {
                <span class="badge @Item.BadgeCssClass rounded-pill ms-auto">@Item.Badge</span>
            }
        </a>
    }
    else
    {
        <NavLink class="nav-link" href="@Item.Href" Match="@(Item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@Tip">
            @if (Item.TagIcon)
            {
                <i class="bi bi-circle-fill bf-tag-icon" aria-hidden="true"></i>
            }
            else
            {
                <i class="bi @IconClass"></i>
            }
            <span class="bf-truncate">@Item.Title</span>
            @if (Item.Count is int count)
            {
                <span class="ms-auto small text-body-secondary">@count.ToString("N0")</span>
            }
            else if (!string.IsNullOrEmpty(Item.Badge))
            {
                <span class="badge @Item.BadgeCssClass rounded-pill ms-auto">@Item.Badge</span>
            }
        </NavLink>
    }
</li>
