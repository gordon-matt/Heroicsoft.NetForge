@* Single-line text prompt, awaited like ConfirmDialog. Returns null when cancelled. *@
@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="this" OnValidSubmit="Submit">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5">@title</h2>
                        <button type="button" class="btn-close" aria-label="Close"
                                @onclick="Cancel"></button>
                    </div>
                    <div class="modal-body">
                        @if (description is not null)
                        {
                            <p class="text-secondary small">@description</p>
                        }
                        <label class="form-label" for="@inputId">@label</label>
                        <input id="@inputId" class="form-control" @ref="inputElement"
                               @bind="Value" @bind:event="oninput" maxlength="@maxLength" autocomplete="off" />
                        @if (error is not null)
                        {
                            <div class="text-danger small mt-1">@error</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary"
                                disabled="@string.IsNullOrWhiteSpace(Value)">
                            @confirmLabel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
