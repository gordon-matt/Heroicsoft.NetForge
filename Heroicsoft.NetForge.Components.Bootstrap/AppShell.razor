@namespace Heroicsoft.NetForge.Components.Bootstrap
<div class="bf-shell @(sidebarCollapsed ? "bf-sidebar-collapsed" : null) @(NavigationPlacement == ForgeNavigationPlacement.Topbar ? "bf-shell-topnav" : null)">
    @if (NavigationPlacement != ForgeNavigationPlacement.Topbar)
    {
        @if (Sidebar is not null)
        {
            @Sidebar
        }
        else
        {
            <Heroicsoft.NetForge.Components.Bootstrap.ForgeSidebar Sections="Sections" Brand="@Brand" BrandHref="@BrandHref"
                          LogoUrl="@LogoUrl" LogoDarkUrl="@LogoDarkUrl" MarkUrl="@MarkUrl"
                          BrandContent="BrandContent" SidebarFooter="SidebarFooter" />
        }
    }

    <div class="bf-main">
        <Heroicsoft.NetForge.Components.Bootstrap.ForgeTopbar ShowSearch="ShowSearch" SearchPlaceholder="@SearchPlaceholder"
                     SearchText="@SearchText"
                     OnSearch="OnSearch" OnToggleSidebar="ToggleSidebar"
                     ShowSidebarToggle="@(NavigationPlacement != ForgeNavigationPlacement.Topbar)"
                     Sections="@(NavigationPlacement == ForgeNavigationPlacement.Topbar ? Sections : [])"
                     Brand="@Brand" BrandHref="@BrandHref" LogoUrl="@LogoUrl" LogoDarkUrl="@LogoDarkUrl"
                     ShowThemePicker="ShowThemePicker"
                     ShowUserMenu="ShowUserMenu" UserMenuItems="UserMenuItems">
            @TopbarEnd
        </Heroicsoft.NetForge.Components.Bootstrap.ForgeTopbar>

        <main class="bf-content">
            @ChildContent
        </main>

        @if (ShowVersion)
        {
            <footer class="bf-version">
                <span class="small text-muted">v@(Version ?? AppVersion.Current)</span>
            </footer>
        }
    </div>
</div>

@if (ShowThemePicker)
{
    <ThemePicker />
}

<Heroicsoft.NetForge.Components.Bootstrap.ForgeDialogHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sidebarCollapsed;

    [Parameter]
    public string? Brand { get; set; }

    [Parameter]
    public string BrandHref { get; set; } = "/";

    [Parameter]
    public string? LogoUrl { get; set; }

    [Parameter]
    public string? LogoDarkUrl { get; set; }

    [Parameter]
    public string? MarkUrl { get; set; }

    [Parameter]
    public RenderFragment? BrandContent { get; set; }

    [Parameter]
    public IReadOnlyList<ForgeNavSection> Sections { get; set; } = [];

    /// <summary>Sidebar is the default. Topbar draws <see cref="Sections"/> in the header instead.</summary>
    [Parameter]
    public ForgeNavigationPlacement NavigationPlacement { get; set; } = ForgeNavigationPlacement.Sidebar;

    /// <summary>Replaces the generated sidebar. Use this when the nav is data the page owns.</summary>
    [Parameter]
    public RenderFragment? Sidebar { get; set; }

    /// <summary>Pinned at the bottom of the generated sidebar.</summary>
    [Parameter]
    public RenderFragment? SidebarFooter { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    /// <summary>The term currently in the address bar. The box copies this when the page changes.</summary>
    [Parameter]
    public string SearchText { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public RenderFragment? TopbarEnd { get; set; }

    [Parameter]
    public bool ShowThemePicker { get; set; } = true;

    [Parameter]
    public bool ShowUserMenu { get; set; } = true;

    [Parameter]
    public IReadOnlyList<ForgeNavItem>? UserMenuItems { get; set; }

    [Parameter]
    public bool ShowVersion { get; set; } = true;

    [Parameter]
    public string? Version { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;
}
