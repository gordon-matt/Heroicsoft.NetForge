@namespace Heroicsoft.NetForge.Components.Bootstrap
@inject DialogService Dialogs

<Heroicsoft.NetForge.Components.Bootstrap.Toaster />
<Heroicsoft.NetForge.Components.Bootstrap.ConfirmDialog @ref="confirmDialog" />
<Heroicsoft.NetForge.Components.Bootstrap.PromptDialog @ref="promptDialog" />

@code {
    private ConfirmDialog confirmDialog = default!;
    private PromptDialog promptDialog = default!;

    protected override void OnAfterRender(bool firstRender)
    {
        Dialogs.Attach(confirmDialog);
        Dialogs.Attach(promptDialog);
    }
}
