<article class="card h-100 @Class">
    <div class="card-body d-flex flex-column">
        @if (!string.IsNullOrEmpty(Title) || TitleEnd is not null)
        {
            <h3 class="h6 card-title d-flex align-items-start gap-2">
                @if (Href is not null)
                {
                    <a class="text-decoration-none" href="@Href">@Title</a>
                }
                else
                {
                    <span>@Title</span>
                }
                @TitleEnd
            </h3>
        }
        @if (Description is not null)
        {
            <p class="card-text text-body-secondary flex-grow-1">@Description</p>
        }
        @ChildContent
        @if (Meta is not null || Actions is not null)
        {
            <div class="d-flex align-items-center justify-content-between gap-2 mt-3 small text-body-secondary">
                <div class="d-flex align-items-center gap-2 flex-wrap">@Meta</div>
                @if (Actions is not null)
                {
                    <div class="d-flex gap-1">@Actions</div>
                }
            </div>
        }
    </div>
</article>
