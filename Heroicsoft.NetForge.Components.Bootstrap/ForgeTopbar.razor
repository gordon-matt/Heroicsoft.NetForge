@namespace Heroicsoft.NetForge.Components.Bootstrap
@inject IAuthProviderService Auth

<header class="bf-topbar">
    @if (ShowSidebarToggle)
    {
        <button type="button" class="btn btn-sm btn-link bf-sidebar-toggle" title="Toggle sidebar"
                @onclick="OnToggleSidebar">
            <i class="bi bi-list fs-4"></i>
        </button>
    }
    else if (Brand is not null || LogoUrl is not null)
    {
        <a class="bf-sidebar-brand-link bf-topbar-brand" href="@BrandHref">
            @if (LogoUrl is not null)
            {
                <img class="bf-brand-logo" src="@LogoUrl" alt="@Brand" />
            }
            @if (LogoDarkUrl is not null)
            {
                <img class="bf-brand-logo-dark" src="@LogoDarkUrl" alt="@Brand" />
            }
            @if (LogoUrl is null && LogoDarkUrl is null)
            {
                <span class="bf-brand-text">@Brand</span>
            }
        </a>
        <button type="button" class="btn btn-sm btn-link bf-sidebar-toggle d-md-none" title="Menu"
                @onclick="() => navOpen = !navOpen">
            <i class="bi bi-list fs-4"></i>
        </button>
    }

    @if (Sections.Count > 0)
    {
        <ul class="nav bf-topnav @(navOpen ? "is-open" : null)">
            @foreach (var section in Sections)
            {
                @if (string.IsNullOrEmpty(section.Roles))
                {
                    @foreach (var item in section.Items)
                    {
                        @if (string.IsNullOrEmpty(item.Roles))
                        {
                            <Heroicsoft.NetForge.Components.Bootstrap.ForgeNavLink Item="item" />
                        }
                        else
                        {
                            <AuthorizeView Roles="@item.Roles">
                                <Heroicsoft.NetForge.Components.Bootstrap.ForgeNavLink Item="item" />
                            </AuthorizeView>
                        }
                    }
                }
                else
                {
                    <AuthorizeView Roles="@section.Roles" Context="sectionUser">
                        @foreach (var item in section.Items)
                        {
                            @if (string.IsNullOrEmpty(item.Roles))
                            {
                                <Heroicsoft.NetForge.Components.Bootstrap.ForgeNavLink Item="item" />
                            }
                            else
                            {
                                <AuthorizeView Roles="@item.Roles" Context="itemUser">
                                    <Heroicsoft.NetForge.Components.Bootstrap.ForgeNavLink Item="item" />
                                </AuthorizeView>
                            }
                        }
                    </AuthorizeView>
                }
            }
        </ul>
    }

    @if (ShowSearch)
    {
        <form class="bf-topbar-search" @onsubmit="SubmitSearch" @onsubmit:preventDefault="true">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-body-tertiary border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="search" class="form-control border-start-0"
                       placeholder="@SearchPlaceholder"
                       aria-label="@SearchPlaceholder" @bind="searchTerm" @bind:event="oninput" />
            </div>
        </form>
    }

    <div class="ms-auto d-flex align-items-center gap-1">
        @if (ShowThemePicker)
        {
            <ThemePickerOpener />
        }

        @ChildContent

        @if (ShowUserMenu)
        {
            <AuthorizeView>
                <Authorized>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link dropdown-toggle text-body" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-md-inline ms-1">@context.User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @foreach (var item in VisibleUserMenuItems(context.User))
                            {
                                <li><a class="dropdown-item" href="@item.Href"><i class="bi @(item.Icon.StartsWith("bi-") ? item.Icon : "bi-" + item.Icon) me-2"></i> @item.Title</a></li>
                            }
                            @if (Auth.Provider != AuthProvider.None)
                            {
                                <li>
                                    @* A POST, so a stray link prefetch can't sign the user out. *@
                                    <form action="@LogoutUrl" method="post">
                                        <AntiforgeryToken />
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign out
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <span class="dropdown-item-text small text-body-secondary">
                                        Running without authentication
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-sm btn-primary" href="@LoginHref">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        }
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    [Parameter]
    public bool ShowSidebarToggle { get; set; } = true;

    [Parameter]
    public IReadOnlyList<ForgeNavSection> Sections { get; set; } = [];

    [Parameter]
    public string? Brand { get; set; }

    [Parameter]
    public string BrandHref { get; set; } = "/";

    [Parameter]
    public string? LogoUrl { get; set; }

    [Parameter]
    public string? LogoDarkUrl { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public bool ShowThemePicker { get; set; } = true;

    [Parameter]
    public bool ShowUserMenu { get; set; } = true;

    [Parameter]
    public IReadOnlyList<ForgeNavItem>? UserMenuItems { get; set; }

    private List<ForgeNavItem> VisibleUserMenuItems(System.Security.Claims.ClaimsPrincipal user) =>
        (UserMenuItems ?? [])
            .Where(item => string.IsNullOrWhiteSpace(item.Roles)
                || item.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Any(user.IsInRole))
            .ToList();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string searchTerm = string.Empty;

    private bool navOpen;

    private string LogoutUrl => Auth.Provider == AuthProvider.Keycloak
        ? "/auth/logout"
        : "/Identity/Account/Logout";

    private string LoginHref => Auth.Provider switch
    {
        AuthProvider.Keycloak => "/auth/login",
        AuthProvider.Identity => "/Identity/Account/Login",
        _ => "/",
    };

    private async Task SubmitSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return;
        }

        await OnSearch.InvokeAsync(searchTerm.Trim());
    }
}
