@typeparam TItem where TItem : class

<div class="chip-input bf-tag-picker @Class">
    <div class="chip-input-tags d-flex flex-wrap gap-1 mb-2">
        @if (Selected.Count == 0)
        {
            <span class="text-secondary small fst-italic">No @Label.ToLowerInvariant() yet.</span>
        }
        else
        {
            @foreach (var item in Selected)
            {
                <span class="chip bf-tag @ChipClass">
                    <span>@NameOf(item)</span>
                    <button type="button" class="btn-close btn-close-sm ms-1" aria-label="Remove" title="Remove" @onclick="() => RemoveAsync(item)"></button>
                </span>
            }
        }
    </div>

    <div class="position-relative">
        <input class="form-control form-control-sm" type="text" id="@Id" autocomplete="off"
               placeholder="@Placeholder"
               @bind="input" @bind:event="oninput"
               @bind:after="OnInputChangedAsync"
               onkeydown="if(event.key==='Enter'){event.preventDefault();}"
               @onkeyup="OnKeyUpAsync"
               @onkeyup:stopPropagation="true"
               @onfocus="OnFocusAsync"
               @onblur="OnBlurAsync" />

        @if (showSuggestions && (suggestions.Count > 0 || !string.IsNullOrWhiteSpace(input)))
        {
            <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm bf-tag-picker-menu">
                @foreach (var suggestion in suggestions)
                {
                    <li>
                        <button type="button" class="dropdown-item" @onmousedown="() => CommitAsync(NameOf(suggestion))" @onmousedown:preventDefault="true">
                            @NameOf(suggestion)
                        </button>
                    </li>
                }
                @if (AllowCreate && !string.IsNullOrWhiteSpace(input) && !suggestions.Any(suggestion => string.Equals(NameOf(suggestion), input.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-item" @onmousedown="() => CommitAsync(input!.Trim())" @onmousedown:preventDefault="true">
                            <i class="bi bi-plus-lg"></i> Create "<strong>@input.Trim()</strong>"
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
</div>
